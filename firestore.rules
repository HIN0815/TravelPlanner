rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(ownerId) {
      return signedIn() && request.auth.uid == ownerId;
    }

    function tripOwner(tripId) {
      return get(/databases/$(database)/documents/trips/$(tripId)).data.ownerId;
    }

    function canReadTrip(tripId) {
      return isOwner(tripOwner(tripId))
        || (
          get(/databases/$(database)/documents/trips/$(tripId)).data.shareId != null
          && exists(/databases/$(database)/documents/shares/$(get(/databases/$(database)/documents/trips/$(tripId)).data.shareId))
        );
    }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /shares/{shareId} {
      allow read: if true;
      allow create, update: if signedIn()
        && isOwner(get(/databases/$(database)/documents/trips/$(request.resource.data.tripId)).data.ownerId);
      allow delete: if signedIn()
        && isOwner(get(/databases/$(database)/documents/trips/$(resource.data.tripId)).data.ownerId);
    }

    match /trips/{tripId} {
      allow read: if canReadTrip(tripId);
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.ownerId);

      match /days/{dayId} {
        allow read: if canReadTrip(tripId);
        allow write: if isOwner(tripOwner(tripId));

        match /spots/{spotId} {
          allow read: if canReadTrip(tripId);
          allow write: if isOwner(tripOwner(tripId));
        }
      }

      match /transports/{transportId} {
        allow read: if canReadTrip(tripId);
        allow write: if isOwner(tripOwner(tripId));
      }

      match /expenses/{expenseId} {
        allow read: if canReadTrip(tripId);
        allow write: if isOwner(tripOwner(tripId));
      }

      match /wishlist/{itemId} {
        allow read: if canReadTrip(tripId);
        allow write: if isOwner(tripOwner(tripId));
      }
    }

    match /wishlists/{uid}/items/{itemId} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
  }
}
